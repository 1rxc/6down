# Server Binding (Cloud platforms automatically inject PORT)
PORT=6060
HOST=0.0.0.0

# Anti-Bot Strategy 1: Rotating / Residential Proxy (HTTP or SOCKS5)
# Example: http://username:password@proxy.example.com:8080 or socks5://127.0.0.1:1080
PROXY_URL=

# Anti-Bot Strategy 2: YouTube Cookies File Path
# Export cookies from your browser (e.g. using 'Get cookies.txt LOCALLY' extension) and save to cookies.txt
COOKIES_PATH=./cookies.txt

# Anti-Bot Strategy 3: Paste raw cookies content directly into environment variable (Great for Heroku/Render/Railway)
COOKIES_CONTENT=

# Anti-Bot Strategy 4: Proof of Origin Token (PO-Token)
# Example: web+TOKEN_HERE
PO_TOKEN=

# Scaling & Concurrency Limits
MAX_CONCURRENT_DOWNLOADS=4
FILE_RETENTION_HOURS=2
